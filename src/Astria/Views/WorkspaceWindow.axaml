<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Astria.Desktop.ViewModels"
        x:Class="Astria.Desktop.Views.WorkspaceWindow" x:DataType="vm:WorkspaceViewModel"
        Title="星屿 · 应用空间" Width="1152" Height="800" MinWidth="950" MinHeight="640"
        SystemDecorations="None" CanResize="True" Background="Transparent"
        TransparencyLevelHint="AcrylicBlur, None" TransparencyBackgroundFallback="#101522"
        WindowStartupLocation="CenterScreen">
  <Border x:Name="WindowFrame" CornerRadius="22" ClipToBounds="True" BorderThickness="1" BorderBrush="#35B6C0EC">
    <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#F4191E32" Offset="0" /><GradientStop Color="#F40F1421" Offset=".55" /><GradientStop Color="#F4181C31" Offset="1" /></LinearGradientBrush></Border.Background>
    <Grid RowDefinitions="48,*">

      <Border  Background="Transparent" PointerPressed="OnTitlePointerPressed">
        <Grid ColumnDefinitions="*,Auto" Margin="24,0,10,0">
          <TextBlock Text="ASTRIA" VerticalAlignment="Center" FontSize="10" LetterSpacing="3" Foreground="#B4C0DC" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="window-control" Click="OnMinimize" AutomationProperties.Name="最小化" ToolTip.Tip="最小化">
              <Path Data="M 1,6 L 11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12" />
            </Button>
            <Button Classes="window-control close" Click="OnHide" AutomationProperties.Name="隐藏到托盘" ToolTip.Tip="关闭窗口，保留托盘">
              <Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Button Classes="quiet" Content="← 返回应用" Click="OnLibrary" IsVisible="{Binding IsSettings}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Margin="32,12,32,22">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,26">
          <StackPanel Spacing="9"><TextBlock Text="ASTRIA" Classes="eyebrow" FontSize="10" /><TextBlock Text="{Binding Heading}" TextWrapping="Wrap" FontSize="23" FontWeight="SemiBold" LetterSpacing="-1" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding IsLibrary}" Spacing="10" Margin="14,0,0,0">
            <Button Content="清空应用库…" Classes="quiet" Click="OnClearLibrary" IsEnabled="{Binding CanInteract}" />
            <Button Classes="primary" Content="＋  添加应用" Click="OnAddApps" IsEnabled="{Binding CanInteract}" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" IsVisible="{Binding IsLibrary}" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
          <Grid><TextBox x:Name="SearchBox" Text="{Binding Query, Mode=TwoWay}" Watermark="搜索应用、拼音或首字母…" Padding="43,13,60,13" Height="50" KeyDown="OnSearchKeyDown" AutomationProperties.Name="搜索应用" /><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#929FBD" Margin="17,0" VerticalAlignment="Center" IsHitTestVisible="False" /><Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" BorderBrush="#30AFBDDF" BorderThickness="1" CornerRadius="5" Padding="5,2" IsHitTestVisible="False"><TextBlock Text="Ctrl K" FontSize="10" Classes="muted" /></Border></Grid>
          <Button Grid.Column="1" Classes="outline" Content="扫描已安装应用" Margin="12,0,0,0" Click="OnScanApps" IsEnabled="{Binding CanInteract}" />
        </Grid>
        <Grid Grid.Row="2" IsVisible="{Binding IsLibrary}" RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <Button IsVisible="{Binding InFolder}" Content="←" Classes="quiet" Click="OnBack" Margin="0,0,8,0" Padding="8,0" AutomationProperties.Name="返回全部应用" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="{Binding ResultLabel}" FontSize="13" FontWeight="Medium" /><TextBlock Text="{Binding AppCount, StringFormat={}{0} 个应用}" Classes="muted" FontSize="11" VerticalAlignment="Center" /></StackPanel>
            <TextBlock Grid.Column="2" Text="拖拽排序 · 右键管理" Classes="muted" FontSize="11" VerticalAlignment="Center" />
          </Grid>
          <ListBox x:Name="AppList" Grid.Row="1" Classes="apps" ItemsSource="{Binding VisibleApps}" SelectionMode="Single" KeyDown="OnAppsKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AppTile">
                <Button Classes="tile" Click="OnTileClick" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Grid Width="51" Height="51">
                      <Border Background="{Binding TileBrush}" CornerRadius="13" IsVisible="{Binding !HasIcon}"><TextBlock Text="{Binding Initial}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D1D9F5" /></Border>
                      <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="48" Height="48" Stretch="Uniform" />
                      <Ellipse Width="7" Height="7" Fill="#9EE2CA" Stroke="#18202E" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding IsRunning}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="110" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#B4C0DC" HorizontalAlignment="Center" Height="14" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="0,0,0,25">
            <TextBlock Text="✦" Foreground="#9489CA" FontSize="40" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyTitle}" FontSize="19" HorizontalAlignment="Center" /><TextBlock Text="{Binding EmptyDescription}" Classes="muted" FontSize="12" HorizontalAlignment="Center" /><Button Classes="outline" Content="添加应用" Click="OnAddApps" HorizontalAlignment="Center" IsEnabled="{Binding CanInteract}" />
          </StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Text="Enter 打开     Esc 收起     Ctrl K 搜索" FontSize="10" Foreground="#ACB8D4" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPages}" VerticalAlignment="Center"><Button x:Name="PreviousPageButton" Classes="page-arrow" Click="OnPrevious" IsEnabled="{Binding HasPrevious}" AutomationProperties.Name="上一页"><Path Data="M 9,2 L 3,8 L 9,14" Width="16" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Button><TextBlock Text="{Binding PageLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="4,0" /><Button x:Name="NextPageButton" Classes="page-arrow" Click="OnNext" IsEnabled="{Binding HasNext}" AutomationProperties.Name="下一页"><Path Data="M 3,2 L 9,8 L 3,14" Width="16" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Button></StackPanel>
          </Grid>
        </Grid>
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" IsVisible="{Binding IsSettings}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" Margin="0,0,7,8"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="唤出 / 隐藏快捷键" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding HotkeyLabel}" FontSize="18" /><TextBlock Text="点击修改后按组合键，冲突时保留原快捷键。Esc 取消录入。" Classes="muted" FontSize="12" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="HotkeyButton" Content="修改快捷键" Classes="outline" Click="OnRecordHotkey" /><Button Content="恢复默认" Classes="quiet" Click="OnResetHotkey" /></StackPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="打开设置快捷键" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding SettingsHotkeyLabel}" FontSize="18" /><TextBlock Text="全局生效；与 Dock 快捷键独立，冲突时保留原设置。" Classes="muted" FontSize="12" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="SettingsHotkeyButton" Content="修改设置快捷键" Classes="outline" Click="OnRecordSettingsHotkey" /><Button Content="恢复默认" Classes="quiet" Click="OnResetSettingsHotkey" /></StackPanel></StackPanel></Border><Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="外观与材质" FontSize="17" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="系统玻璃材质" /><TextBlock Text="使用原生 Acrylic；不可用时自动回退为实色" Classes="muted" FontSize="11" /></StackPanel><ToggleSwitch Grid.Column="1" x:Name="AcrylicToggle" IsChecked="{Binding UseAcrylic, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="系统玻璃材质" /></Grid><Border Height="1" Background="#18B0BDE4" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="强调色" /><TextBlock Text="在安静的底色里，保留一点个性" Classes="muted" FontSize="11" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><Button x:Name="LavenderButton" Background="#B8ADFF" Width="29" Height="29" MinHeight="29" Padding="0" CornerRadius="15" Tag="lavender" Click="OnAccent" AutomationProperties.Name="薰衣草紫" /><Button x:Name="OceanButton" Background="#8FCFFF" Width="29" Height="29" MinHeight="29" Padding="0" CornerRadius="15" Tag="ocean" Click="OnAccent" AutomationProperties.Name="晴空蓝" /><Button x:Name="MintButton" Background="#9AE2C7" Width="29" Height="29" MinHeight="29" Padding="0" CornerRadius="15" Tag="mint" Click="OnAccent" AutomationProperties.Name="薄荷绿" /></StackPanel></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="页面与 Dock 主题" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding ThemeName, StringFormat=当前主题：{0}}" Classes="muted" FontSize="11" /><WrapPanel><Button Content="极光 · 青绿与紫" Tag="aurora" Click="OnAccent" Classes="outline" Margin="0,0,10,8" /><Button Content="赛博 · 霓虹粉蓝" Tag="neon" Click="OnAccent" Classes="outline" Margin="0,0,10,8" /><Button Content="深海 · 冰蓝" Tag="abyss" Click="OnAccent" Classes="outline" Margin="0,0,10,8" /><Button Content="暖金 · 琥珀" Tag="gold" Click="OnAccent" Classes="outline" Margin="0,0,10,8" /></WrapPanel></StackPanel></Border><Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="相册与交互" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Dock 空间形状" FontSize="13" /><TextBlock Text="{Binding FavoriteShapeName, StringFormat=当前形状：{0}}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding FavoriteShapeDescription}" Classes="muted" FontSize="11" TextWrapping="Wrap" /><WrapPanel><Button Content="双层轨道" Tag="orbits" Classes="outline" Click="OnShape" Margin="0,0,10,8" /><Button Content="银河旋臂" Tag="galaxy" Classes="outline" Click="OnShape" Margin="0,0,10,8" /><Button Content="悬浮矩阵" Tag="matrix" Classes="outline" Click="OnShape" Margin="0,0,10,8" /></WrapPanel><Grid ColumnDefinitions="*,220"><StackPanel Spacing="5"><TextBlock Text="每页最多显示" /><TextBlock Text="{Binding FavoriteLayoutLabel}" Classes="muted" FontSize="12" /><TextBlock Text="常用和应用页均生效；支持 1–24 张，超出数量翻页" Classes="muted" FontSize="11" /></StackPanel><Slider Grid.Column="1" Minimum="1" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FavoriteVisibleCount, Mode=TwoWay}" AutomationProperties.Name="每页最多显示" /></Grid><Border Height="1" Background="#18B0BDE4" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="全屏沉浸星空" /><TextBlock Text="呼出时铺满深空夜幕与星云，点击背景或启动后自动退场" Classes="muted" FontSize="11" /></StackPanel><ToggleSwitch Grid.Column="1" x:Name="ImmersiveToggle" IsChecked="{Binding ImmersiveLaunchpad, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="全屏沉浸星空" /></Grid><Border Height="1" Background="#18B0BDE4" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="启动时隐藏桌面图标" /><TextBlock Text="开启后每次启动隐藏，关闭则显示；功能栏可临时切换，退出时恢复原状态" Classes="muted" FontSize="11" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" x:Name="DesktopIconsStartupToggle" IsChecked="{Binding HideDesktopIconsOnStartup, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="启动时隐藏桌面图标" /></Grid><Border Height="1" Background="#18B0BDE4" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="自动隐藏操作栏" /><TextBlock Text="鼠标靠近屏幕底部时浮现，移开后自动隐入深空" Classes="muted" FontSize="11" /></StackPanel><ToggleSwitch Grid.Column="1" x:Name="AutoHideToggle" IsChecked="{Binding AutoHideDock, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="自动隐藏操作栏" /></Grid><Border Height="1" Background="#18B0BDE4" /><Grid ColumnDefinitions="*,230"><StackPanel Spacing="5"><TextBlock Text="卡片大小" /><TextBlock Text="{Binding DockScale, StringFormat={}{0:P0}}" Classes="muted" FontSize="11" /></StackPanel><Slider Grid.Column="1" Minimum="0.75" Maximum="1.3" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding DockScale, Mode=TwoWay}" AutomationProperties.Name="卡片大小" /></Grid><Border Height="1" Background="#18B0BDE4" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="减少动态效果" /><TextBlock Text="关闭卡片切换动画，保持界面平稳" Classes="muted" FontSize="11" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding ReduceMotion, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="减少动态效果" /></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="登录时启动" /><TextBlock Text="仅注册当前用户的 Avalonia 版本，不更改原版启动项" Classes="muted" FontSize="11" /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="登录时启动" /></Grid></StackPanel></Border><Border Classes="card"><StackPanel Spacing="15"><TextBlock Text="数据与你" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="独立数据空间，与原 WPF 版互不覆盖。备份包含应用、布局、外观与自定义图标。" Classes="muted" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding DataDirectory}" FontSize="11" Foreground="#B4C0DC" TextWrapping="Wrap" /><WrapPanel><Button Content="打开数据目录" Classes="outline" Click="OnOpenData" Margin="0,0,10,8" /><Button Content="备份数据" Classes="outline" Click="OnBackup" Margin="0,0,10,8" IsEnabled="{Binding CanInteract}" /><Button Content="恢复备份" Classes="outline" Click="OnRestore" Margin="0,0,10,8" IsEnabled="{Binding CanInteract}" /></WrapPanel></StackPanel></Border>
            <TextBlock Text="星屿 Astria / 本地应用空间" Classes="muted" FontSize="11" Margin="4,4" />
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" BorderBrush="#18B0BDE4" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto"><Ellipse Fill="#9AE2C7" Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Status}" /><ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="70" Height="3" Margin="12,0,0,0" /></Grid>
        </Border>
      </Grid>
      <Border x:Name="FileDropOverlay" Grid.RowSpan="2" IsVisible="False" IsHitTestVisible="False" ZIndex="90" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,66" Padding="16,12" CornerRadius="14" Background="#F0202940" BorderBrush="#608D83C4" BorderThickness="1" BoxShadow="0 6 18 0 #50000000">
        <Grid ColumnDefinitions="Auto,*">
          <Border Width="30" Height="30" CornerRadius="9" Background="#303D375F" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="＋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D5CDFF" /></Border>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="松开添加应用" FontSize="13" FontWeight="Medium" Foreground="#F4F6FF" />
            <TextBlock Text="支持快捷方式、文件与文件夹" FontSize="11" Foreground="#BDC8E1" />
          </StackPanel>
        </Grid>
      </Border>
      <Canvas x:Name="DragLayer" Grid.RowSpan="2" IsHitTestVisible="False" ZIndex="100" />
    </Grid>
  </Border>
</Window>
